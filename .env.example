# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address (must be a verified domain in your Resend account)
FROM_EMAIL=Ascend Website <noreply@yourdomain.com.au>

# Recipient for admin notifications (quote leads, subcontractor packs, colour confirmations)
BUSINESS_EMAIL=admin@yourdomain.com.au

# ─── Google Maps / Solar API ──────────────────────────────────────────────────
# Server-side key — restrict to your Vercel project IPs or leave as API-restricted
# Required APIs: Maps JavaScript API, Places API, Solar API, Static Maps API
#
# ⚠ "Places API" here means the LEGACY product, not "Places API (New)" — they
# are two separate entries in the Google Cloud API library and enabling one
# does not enable the other. Address autocomplete uses the legacy endpoints
# because only their Place Details response returns address_components, which
# is what fills the separate suburb / state / postcode fields. If the address
# dropdown stops appearing, check the Vercel function logs for REQUEST_DENIED
# and enable "Places API" on the project.
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_SERVER_KEY_HERE

# TODO(owner): browser-visible key for Static Maps URLs in quote results.
# Rotate the old key (it shipped in git history), restrict the new one to the
# Static Maps API + HTTP-referrer allow-list + daily quota cap, then set it here.
GOOGLE_MAPS_FRONTEND_KEY=AIzaSy_YOUR_RESTRICTED_BROWSER_KEY_HERE

# ─── Anthropic / Claude AI (insurance document extraction) ────────────────────
# Used in /api/submit-subby-pack.js via lib/extract-insurance-data.js
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Vercel Postgres (subcontractor & insurance data) ─────────────────────────
# Automatically set when you link a Vercel Postgres database in your project
POSTGRES_URL=postgres://default:password@host/verceldb?sslmode=require
POSTGRES_PRISMA_URL=postgres://default:password@host/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://default:password@host/verceldb?sslmode=require
POSTGRES_USER=default
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=verceldb

# ─── Security ─────────────────────────────────────────────────────────────────
# TODO(owner): required — protects /api/cron/check-expiring-insurance. The cron
# endpoint rejects all requests until this is set. Vercel sends it automatically
# once configured in project env vars. Generate: openssl rand -hex 24
CRON_SECRET=your-random-secret-string

# Origins allowed to submit forms (comma-separated). Defaults to the production
# domains. Add your Vercel preview URL here or form posts from previews get 403.
ALLOWED_ORIGINS=https://ascendroofinggroup.com.au,https://www.ascendroofinggroup.com.au

# TODO(owner): encrypts TFN/bank fields at rest (AES-256-GCM). Before setting,
# run the column-widening migration at the bottom of schema.sql.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=64_hex_chars_from_openssl_rand_hex_32

# TODO(owner): durable cross-instance rate limiting. Create an Upstash Redis
# database (Vercel Marketplace → Upstash, free tier) and paste its REST values.
# Without these, rate limits fall back to per-instance memory (best effort).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Optional ─────────────────────────────────────────────────────────────────
# URL used in quote result to link to scheduling/booking tool
SCHEDULER_URL=https://calendly.com/your-link
