# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address (must be a verified domain in your Resend account)
FROM_EMAIL=Ascend Website <noreply@yourdomain.com.au>

# Recipient for admin notifications (quote leads, subcontractor packs, colour confirmations)
BUSINESS_EMAIL=admin@yourdomain.com.au

# ─── Google Maps / Solar API ──────────────────────────────────────────────────
# Server-side key — restrict to your Vercel project IPs or leave as API-restricted
# Required APIs: Maps JavaScript API, Places API, Solar API, Static Maps API
GOOGLE_MAPS_API_KEY=AIzaSy_YOUR_SERVER_KEY_HERE

# ─── Anthropic / Claude AI (insurance document extraction) ────────────────────
# Used in /api/submit-subby-pack.js via lib/extract-insurance-data.js
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Vercel Postgres (subcontractor & insurance data) ─────────────────────────
# Automatically set when you link a Vercel Postgres database in your project
POSTGRES_URL=postgres://default:password@host/verceldb?sslmode=require
POSTGRES_PRISMA_URL=postgres://default:password@host/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgres://default:password@host/verceldb?sslmode=require
POSTGRES_USER=default
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=verceldb

# ─── Optional ─────────────────────────────────────────────────────────────────
# URL used in quote result to link to scheduling/booking tool
SCHEDULER_URL=https://calendly.com/your-link
